generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  createdAt               DateTime                 @default(now())
  username                String                   @unique @db.VarChar(40)
  name                    String?                  @db.VarChar(80)
  description             String?                  @db.VarChar(1000)
  showPremiumBadge        Boolean                  @default(false)
  email                   String                   @unique @db.VarChar(254)
  emailVerified           Boolean                  @default(false)
  locale                  String                   @default("en") @db.VarChar(2)
  passwordHash            String?
  identities              AuthIdentity[]
  image                   Media?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  ownedLists              Wishlist[]               @relation("ListOwner")
  authoredWishes          Wish[]                   @relation("WishAuthor")
  memberships             Membership[]
  reservationParticipants ReservationParticipant[] @relation("ReservationParticipant")
  reservationInvitations  ReservationParticipant[] @relation("ReservationInviter")
  reservations            Reservation[]
  premiumGrants           PremiumGrant[]
  promoRedemptions        PromoRedemption[]
  sentInvitations         Invitation[]             @relation("InvitationSender")
  receivedInvitations     Invitation[]             @relation("InvitationRecipient")
  billingAccounts         BillingAccount[]
  accountEmails           AccountEmail[]
  favoriteLists           FavoriteList[]
  favoriteWishes          FavoriteWish[]
  favoritePeople          FavoritePerson[]         @relation("FavoriteOwner")
  favoritedBy             FavoritePerson[]         @relation("FavoritePerson")
}

// Transactional account and group messages, retained for deduplication and removed with the account.
model AccountEmail {
  id                 String                  @id @default(cuid())
  key                String                  @unique
  createdAt          DateTime                @default(now())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantId            String?
  groupParticipantId String?
  groupParticipant   ReservationParticipant? @relation(fields: [groupParticipantId], references: [id], onDelete: Cascade)
  groupEmailKind     GroupEmailKind?
  recipient          String                  @db.VarChar(254)
  sender             String
  subject            String
  html               String
  text               String
  sentAt             DateTime?
  canceledAt         DateTime?
  firstAttemptAt     DateTime?
  nextAttemptAt      DateTime                @default(now())
  deliveryAttempts   Int                     @default(0)
  deliveryFailedAt   DateTime?
  claimId            String?

  @@index([groupParticipantId])
  @@index([sentAt, canceledAt, deliveryFailedAt, nextAttemptAt])
  @@index([userId])
}

model Session {
  id                      String    @id
  expiresAt               DateTime
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleReauthenticatedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model AuthIdentity {
  provider String @db.VarChar(20)
  subject  String @db.VarChar(255)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, subject])
  @@unique([userId, provider])
}

// Short-lived, single-use authorization requests. Provider tokens are never retained.
model GoogleAuthRequest {
  stateHash    String   @id
  codeVerifier String   @db.VarChar(128)
  nonce        String   @db.VarChar(128)
  locale       String   @db.VarChar(2)
  returnTo     String   @db.VarChar(512)
  intent       String   @db.VarChar(20)
  sessionId    String?
  expiresAt    DateTime

  @@index([expiresAt])
}

model EmailVerificationToken {
  userId    String   @id
  codeHash  String
  email     String   @db.VarChar(254)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetToken {
  tokenHash String   @id
  userId    String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model Wishlist {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  title               String         @db.VarChar(200)
  description         String?        @db.VarChar(2000)
  theme               String         @default("classic") @db.VarChar(20)
  publication         Publication    @default(PUBLISHED)
  visibility          ListVisibility @default(PUBLIC)
  reservationsEnabled Boolean        @default(true)
  archivedAt          DateTime?
  ownerId             String?
  owner               User?          @relation("ListOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  wishes              Wish[]
  image               Media?
  invitations         Invitation[]
  guestLinks          GuestLink[]
  favorites           FavoriteList[]

  @@index([ownerId, archivedAt, createdAt])
  @@index([visibility, publication, archivedAt, createdAt])
}

model Membership {
  id         String         @id @default(cuid())
  joinedAt   DateTime       @default(now())
  role       MembershipRole @default(MEMBER)
  wishlistId String
  userId     String
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, userId])
  @@index([userId, joinedAt])
}

model GuestLink {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  label      String    @db.VarChar(80)
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  wishlistId String
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@index([wishlistId, createdAt])
}

// The ID locates an invitation; only its verified intended email can accept it.
model Invitation {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  expiresAt        DateTime
  email            String         @db.VarChar(254)
  locale           String         @default("en") @db.VarChar(2)
  role             MembershipRole
  acceptedAt       DateTime?
  revokedAt        DateTime?
  wishlistId       String
  inviterId        String
  recipientId      String?
  wishlist         Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  inviter          User           @relation("InvitationSender", fields: [inviterId], references: [id], onDelete: Cascade)
  recipient        User?          @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sentAt           DateTime?
  firstAttemptAt   DateTime?
  nextAttemptAt    DateTime       @default(now())
  deliveryAttempts Int            @default(0)
  deliveryFailedAt DateTime?
  claimId          String?

  @@index([wishlistId, createdAt])
  @@index([inviterId])
  @@index([recipientId])
  @@index([email])
  @@index([sentAt, nextAttemptAt])
}

model Wish {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  title        String         @db.VarChar(200)
  description  String?        @db.VarChar(4000)
  externalUrl  String?        @db.VarChar(2048)
  priceMinor   Int?
  currency     Currency?
  priority     Int?           @db.SmallInt
  hidden       Boolean        @default(false)
  fulfilledAt  DateTime?
  wishlistId   String
  authorId     String?
  wishlist     Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  author       User?          @relation("WishAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reservations Reservation[]
  image        Media?
  favorites    FavoriteWish[]

  @@index([wishlistId, hidden, fulfilledAt, createdAt])
  @@index([authorId])
}

model FavoriteList {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  wishlistId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([userId, wishlistId])
  @@index([userId, createdAt, id])
  @@index([wishlistId])
}

model FavoriteWish {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  wishId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)

  @@unique([userId, wishId])
  @@index([userId, createdAt, id])
  @@index([wishId])
}

model FavoritePerson {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  personId  String
  user      User     @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  person    User     @relation("FavoritePerson", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId])
  @@index([userId, createdAt, id])
  @@index([personId])
}

model Reservation {
  groupEnabled Boolean                  @default(false)
  participants ReservationParticipant[]
  id           String                   @id @default(cuid())
  createdAt    DateTime                 @default(now())
  endedAt      DateTime?
  wishId       String
  userId       String
  wish         Wish                     @relation(fields: [wishId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A partial unique index in the migration permits one active reservation per wish.
  @@index([wishId, endedAt])
  @@index([userId, endedAt, createdAt])
}

model ReservationParticipant {
  id            String                       @id @default(cuid())
  createdAt     DateTime                     @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?
  status        ReservationParticipantStatus @default(PENDING)
  reservationId String
  userId        String
  inviterId     String?
  reservation   Reservation                  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user          User                         @relation("ReservationParticipant", fields: [userId], references: [id], onDelete: Cascade)
  inviter       User?                        @relation("ReservationInviter", fields: [inviterId], references: [id], onDelete: SetNull)
  emails        AccountEmail[]

  @@unique([reservationId, userId])
  @@index([userId, status, createdAt])
  @@index([inviterId])
}

enum ReservationParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  LEFT
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum Publication {
  DRAFT
  PUBLISHED
}

enum ListVisibility {
  PUBLIC
  PRIVATE
}

enum Currency {
  EUR
  USD
  GBP
}

// Detached rows are the durable cleanup queue, including interrupted uploads.
model Media {
  id             String        @id @default(cuid())
  pathname       String        @unique
  provider       MediaProvider
  state          MediaState    @default(PENDING)
  alt            String        @db.VarChar(300)
  width          Int
  height         Int
  bytes          Int
  variantWidths  Int[]         @default([])
  variantVersion Int           @default(0)
  cleanupAfter   DateTime
  attempts       Int           @default(0)
  wishlistId     String?       @unique
  wishId         String?       @unique
  userId         String?       @unique
  wishlist       Wishlist?     @relation(fields: [wishlistId], references: [id], onDelete: SetNull)
  wish           Wish?         @relation(fields: [wishId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cleanupAfter])
}

enum MediaProvider {
  LOCAL
  VERCEL
}

enum MediaState {
  PENDING
  READY
  DELETING
}

model PremiumGrant {
  id                String           @id @default(cuid())
  createdAt         DateTime         @default(now())
  startsAt          DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  userId            String
  promoRedemptionId String?          @unique
  billingPaymentId  String?          @unique
  billingPayment    BillingPayment?  @relation(fields: [billingPaymentId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoRedemption   PromoRedemption? @relation(fields: [promoRedemptionId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model PromoCode {
  id              String            @id @default(cuid())
  createdAt       DateTime          @default(now())
  label           String            @db.VarChar(80)
  codeHash        String            @unique @db.VarChar(64)
  durationDays    Int
  maxRedemptions  Int
  redemptionCount Int               @default(0)
  expiresAt       DateTime
  revokedAt       DateTime?
  redemptions     PromoRedemption[]
}

model PromoRedemption {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  userId      String
  promoCodeId String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode   PromoCode     @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  grant       PremiumGrant?

  @@unique([promoCodeId, userId])
  @@index([userId])
}

enum BillingEnvironment {
  sandbox
  live
}

// Retained without profile data after deletion so late payments can be canceled.
model BillingAccount {
  customerId    String?
  environment   BillingEnvironment    @default(sandbox)
  id            String                @id @default(cuid())
  createdAt     DateTime              @default(now())
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  deletedAt     DateTime?
  nextSyncAt    DateTime              @default(now())
  claimId       String?
  leaseUntil    DateTime?
  revision      Int                   @default(0)
  attempts      Int                   @default(0)
  lastSyncedAt  DateTime?
  checkouts     BillingCheckout[]
  subscriptions BillingSubscription[]

  @@unique([userId, environment])
  @@unique([customerId, environment])
  @@index([environment, nextSyncAt])
}

model BillingCheckout {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  accountId       String
  account         BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  interval        String         @db.VarChar(10)
  priceId         String
  transactionId   String?        @unique
  dispatchedAt    DateTime?
  closedAt        DateTime?
  cancelRequested Boolean        @default(false)

  @@index([accountId, closedAt])
}

model BillingSubscription {
  id           String           @id
  accountId    String
  account      BillingAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId   String
  status       String
  interval     String
  nextBilledAt DateTime?
  cancelAt     DateTime?
  updatedAt    DateTime
  payments     BillingPayment[]

  @@index([accountId])
}

model BillingPayment {
  id             String              @id
  subscriptionId String
  subscription   BillingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  expiresAt      DateTime
  refunded       Boolean             @default(false)
  grant          PremiumGrant?
}

// Only event/resource identifiers are retained; payloads may contain customer PII.
model BillingEvent {
  environment   BillingEnvironment @default(sandbox)
  id            String             @id
  createdAt     DateTime           @default(now())
  type          String
  resourceId    String
  nextAttemptAt DateTime           @default(now())
  attempts      Int                @default(0)
  processedAt   DateTime?

  @@index([environment, processedAt, nextAttemptAt])
}

enum GroupEmailKind {
  INVITED
  ACCEPTED
}
