{
  "name": "the-road-to-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run localization:check && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint-fix": "eslint . --fix",
    "type": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "preemail": "node --import tsx scripts/prepare-email-preview.ts",
    "email": "EMAIL_PREVIEW=1 email dev --dir src/emails --port 3001",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run localization:check && npm run lint && npm run lint:css && npm run format:check && npm run type && npm test",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migration": "prisma migrate dev",
    "db:studio": "prisma studio --port 5555",
    "test:integration": "tsx scripts/e2e.ts --integration",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:e2e:cross-browser": "tsx scripts/e2e.ts --config playwright.cross-browser.config.ts",
    "test:e2e:auth-protection": "tsx scripts/e2e.ts --config playwright.auth-protection.config.ts",
    "performance:lab": "tsx scripts/performance.ts",
    "performance:summary": "node --import tsx scripts/performance-summary.ts",
    "db:rebuild:up": "docker compose -f compose.rebuild.yaml up -d --wait dev-db dev-mail",
    "db:rebuild:down": "docker compose -f compose.rebuild.yaml down",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "media:backfill": "tsx scripts/backfill-media.ts",
    "promo": "tsx scripts/promo.ts",
    "invitations:deliver": "tsx scripts/deliver-invitations.ts",
    "emails:deliver": "tsx scripts/deliver-account-emails.ts",
    "billing:sync": "tsx scripts/reconcile-billing.ts",
    "operations:status": "tsx scripts/operations-status.ts",
    "operations:backup": "tsx scripts/backup-restore.ts",
    "operations:recovery-drill": "tsx scripts/recovery-drill.ts",
    "localization:generate": "node --import tsx scripts/client-translations.ts --write",
    "localization:check": "node --import tsx scripts/client-translations.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^18.0.4",
    "inngest": "^4.21.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.48.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "opentype.js": "^2.0.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.6",
    "resend": "^6.30.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@react-email/ui": "^6.11.6",
    "@types/node": "^24.19.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "inngest-cli": "^1.45.1",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "type": "module",
  "overrides": {
    "inngest": {
      "zod": "$zod"
    },
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "inngest-cli": {
      "adm-zip": "^0.6.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.4"
    }
  }
}
